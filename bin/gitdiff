#!/bin/sh
# Launcher for the GitDiff desktop app.
#
# Works from three places, checked in this order:
#   1. inside an installed GitDiff.app (this script ships in Contents/Resources/bin)
#   2. an installed GitDiff.app found in the usual locations
#   3. a source checkout, using the project's own electron
#
# The app is launched detached so it does not tie up your terminal, and always
# receives an absolute path — its working directory is not yours.

set -e

VERSION="0.1.0"

usage() {
  cat <<'EOF'
gitdiff — review what your coding agent changed

Usage:
  gitdiff [path]     Open a repository (defaults to the current directory)
  gitdiff flow [...] Render a mermaid diagram (see `gitdiff flow --help`)
  gitdiff comments   Print the review comments left in GitDiff, for your agent
                     (see `gitdiff comments --help`)
  gitdiff --help     Show this message
  gitdiff --version  Show the version

Environment:
  GITDIFF_APP        Path to GitDiff.app, if it lives somewhere unusual
EOF
}

flow_usage() {
  cat <<'EOF'
gitdiff flow — show a mermaid diagram in the Flows tab

Usage:
  gitdiff flow [file]          Render a .mmd file, or a .md file's ```mermaid blocks
  gitdiff flow                 Read the diagram from stdin
  gitdiff flow -t "Title" ...  Name it

Meant to be called by a coding agent when you ask it to explain something
visually — it writes the diagram, pipes it here, and the window comes forward:

  gitdiff flow --title "Request flow" <<'MMD'
  flowchart TD
    A[Client] --> B[API]
    B --> C[(Database)]
  MMD
EOF
}

mode="repo"
target=""
flow_title=""
flow_src=""

if [ "$1" = "comments" ]; then
  # Everything after the word is the CLI's own business; it's handed over as-is.
  mode="comments"
  shift
elif [ "$1" = "flow" ]; then
  mode="flow"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      -h|--help) flow_usage; exit 0 ;;
      -t|--title)
        [ $# -ge 2 ] || { echo "gitdiff flow: --title needs a value" >&2; exit 2; }
        flow_title="$2"; shift 2 ;;
      --title=*) flow_title="${1#--title=}"; shift ;;
      -) flow_src=""; shift ;;
      -*) printf 'gitdiff flow: unknown option %s\n\n' "$1" >&2; flow_usage >&2; exit 2 ;;
      *) flow_src="$1"; shift ;;
    esac
  done
else
  for arg in "$@"; do
    case "$arg" in
      -h|--help) usage; exit 0 ;;
      -v|--version) echo "gitdiff $VERSION"; exit 0 ;;
      -*) printf 'gitdiff: unknown option %s\n\n' "$arg" >&2; usage >&2; exit 2 ;;
      *) target="$arg" ;;
    esac
  done
fi

if [ "$mode" = "comments" ]; then
  :
elif [ "$mode" = "flow" ]; then
  if [ -n "$flow_src" ]; then
    [ -f "$flow_src" ] || { echo "gitdiff flow: no such file: $flow_src" >&2; exit 1; }
    # A real file is handed over as itself, so the app can show where the
    # diagram came from; only stdin needs a temporary.
    flow_file=$(cd "$(dirname "$flow_src")" && pwd)/$(basename "$flow_src")
    flow_temp=""
  else
    if [ -t 0 ]; then
      echo "gitdiff flow: no diagram given — pass a file or pipe one in" >&2
      echo "try: gitdiff flow --help" >&2
      exit 2
    fi
    flow_file=$(mktemp "${TMPDIR:-/tmp}/gitdiff-flow.XXXXXX")
    # The app is launched detached and reads this after we exit, so it is
    # written in full first and the app deletes it once it has been read.
    cat >"$flow_file"
    if [ ! -s "$flow_file" ]; then
      rm -f "$flow_file"
      echo "gitdiff flow: the diagram was empty" >&2
      exit 2
    fi
    flow_temp="--gitdiff-flow-temp"
  fi
else
  [ -n "$target" ] || target="."

  # Resolve to an absolute path. A directory is used as-is; a file is opened at
  # its containing directory, since what we want is the repository around it.
  if [ -d "$target" ]; then
    abs=$(cd "$target" && pwd)
  elif [ -e "$target" ]; then
    abs=$(cd "$(dirname "$target")" && pwd)
  else
    echo "gitdiff: no such file or directory: $target" >&2
    exit 1
  fi
fi

# Follow symlinks to find where this script really lives — it is normally
# reached through a symlink on PATH.
self="$0"
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)

# `gitdiff comments` prints rather than opening a window: the agent reads its
# output. So it runs in the foreground, as plain Node inside the app's own
# Electron (ELECTRON_RUN_AS_NODE) — no separate Node install needed. The
# script ships unpacked from the asar archive so this works on any Electron.
if [ "$mode" = "comments" ]; then
  cwd=$(pwd)
  # As a Claude Code hook this runs on every prompt, everywhere. In a repo that
  # has never had a review comment — or no repo at all — say nothing without
  # starting Electron.
  case " $* " in
    *" --hook "*)
      gitdir=$(git -C "$cwd" rev-parse --absolute-git-dir 2>/dev/null) || exit 0
      [ -f "$gitdir/gitdiff/review.json" ] || exit 0
      ;;
  esac
  if [ -x "$here/../../MacOS/GitDiff" ] && [ -f "$here/../app.asar.unpacked/out/main/comments-cli.js" ]; then
    exe="$here/../../MacOS/GitDiff"
    script="$here/../app.asar.unpacked/out/main/comments-cli.js"
  else
    exe=""
    for candidate in "$GITDIFF_APP" "/Applications/GitDiff.app" "$HOME/Applications/GitDiff.app"; do
      [ -n "$candidate" ] || continue
      if [ -x "$candidate/Contents/MacOS/GitDiff" ] &&
        [ -f "$candidate/Contents/Resources/app.asar.unpacked/out/main/comments-cli.js" ]; then
        exe="$candidate/Contents/MacOS/GitDiff"
        script="$candidate/Contents/Resources/app.asar.unpacked/out/main/comments-cli.js"
        break
      fi
    done
    if [ -z "$exe" ]; then
      project=$(cd "$here/.." && pwd)
      exe="$project/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
      script="$project/out/main/comments-cli.js"
    fi
  fi
  if [ ! -x "$exe" ] || [ ! -f "$script" ]; then
    echo "gitdiff comments: could not find GitDiff — install the app, or run 'npm run build' in the checkout" >&2
    exit 1
  fi
  ELECTRON_RUN_AS_NODE=1 exec "$exe" "$script" "$cwd" "$@"
fi

# The arguments the app itself gets, built once so every launch path below
# hands over the same thing. Positional parameters because this is POSIX sh and
# a plain string would come apart on the first space in a title or a path.
if [ "$mode" = "flow" ]; then
  set -- "--gitdiff-flow=$flow_file"
  if [ -n "$flow_temp" ]; then set -- "$@" "$flow_temp"; fi
  if [ -n "$flow_title" ]; then set -- "$@" "--gitdiff-flow-title=$flow_title"; fi
else
  set -- "$abs"
fi

launch() {
  # nohup + & so the app outlives this shell.
  nohup "$@" >/dev/null 2>&1 &
  exit 0
}

# 1. Shipped inside the app bundle. This script sits at
#    GitDiff.app/Contents/Resources/bin/gitdiff, so the executable is two
#    levels up and across, at Contents/MacOS/GitDiff.
bundled="$here/../../MacOS/GitDiff"
[ -x "$bundled" ] && launch "$bundled" "$@"

# 2. An installed app bundle.
for candidate in "$GITDIFF_APP" "/Applications/GitDiff.app" "$HOME/Applications/GitDiff.app"; do
  [ -n "$candidate" ] || continue
  if [ -x "$candidate/Contents/MacOS/GitDiff" ]; then
    launch "$candidate/Contents/MacOS/GitDiff" "$@"
  fi
done

# 3. A source checkout.
project=$(cd "$here/.." && pwd)
electron="$project/node_modules/electron/dist/Electron.app/Contents/MacOS/Electron"
if [ -x "$electron" ]; then
  if [ ! -f "$project/out/main/index.js" ]; then
    echo "gitdiff: no build found — run 'npm run build' in $project" >&2
    exit 1
  fi
  launch "$electron" "$project" "$@"
fi

cat >&2 <<'EOF'
gitdiff: could not find GitDiff.

Install the app to /Applications, or set GITDIFF_APP to its location:
  GITDIFF_APP=/path/to/GitDiff.app gitdiff .
EOF
exit 1
